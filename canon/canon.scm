(define (common-measure a b)
  (cond ((= b 0) a)
        (else (common-measure b (remainder a b)))))

(define (bisect holds? low high)
  (cond ((= low high) low)
        (else (narrow holds? low (+ low (quotient (- high low) 2)) high))))

(define (narrow holds? low middle high)
  (cond ((holds? middle) (bisect holds? low middle))
        (else (bisect holds? (+ middle 1) high))))

(define (replay apply initial log)
  (cond ((null? log) initial)
        (else (apply (replay apply initial (cdr log)) (cdr (car log))))))

(define (recorded key log)
  (cond ((null? log) #f)
        ((eq? key (car (car log))) (car log))
        (else (recorded key (cdr log)))))

(define (accept decide apply initial log key request)
  (cond ((recorded key log) log)
        (else (cons (cons key (decide (replay apply initial log) request)) log))))

(define (evaluate expression environment program)
  (cond ((symbol? expression) (lookup expression environment program))
        ((pair? expression) (evaluate-form (car expression) (cdr expression) environment program))
        (else expression)))

(define (evaluate-form head rest environment program)
  (cond ((eq? head 'quote) (car rest))
        ((eq? head 'cond) (evaluate-clauses rest environment program))
        ((eq? head 'lambda) (list 'closure (car rest) (second rest) environment))
        (else (invoke (evaluate head environment program)
                      (evaluate-each rest environment program)
                      program))))

(define (evaluate-clauses clauses environment program)
  (cond ((eq? (car (car clauses)) 'else) (evaluate (second (car clauses)) environment program))
        ((evaluate (car (car clauses)) environment program) (evaluate (second (car clauses)) environment program))
        (else (evaluate-clauses (cdr clauses) environment program))))

(define (evaluate-each expressions environment program)
  (cond ((null? expressions) '())
        (else (cons (evaluate (car expressions) environment program)
                    (evaluate-each (cdr expressions) environment program)))))

(define (lookup name environment program)
  (cond ((null? environment) (defined name program))
        ((eq? name (car (car environment))) (cdr (car environment)))
        (else (lookup name (cdr environment) program))))

(define (defined name program)
  (cond ((null? program) (list 'primitive name))
        ((eq? name (car (second (car program))))
         (list 'closure (cdr (second (car program))) (third (car program)) '()))
        (else (defined name (cdr program)))))

(define (invoke procedure arguments program)
  (cond ((eq? (car procedure) 'closure)
         (evaluate (third procedure) (bind (second procedure) arguments (fourth procedure)) program))
        (else (primitive (second procedure) arguments))))

(define (bind names arguments environment)
  (cond ((null? names) environment)
        (else (cons (cons (car names) (car arguments))
                    (bind (cdr names) (cdr arguments) environment)))))

(define (primitive name arguments)
  (cond ((eq? name 'car) (car (car arguments)))
        ((eq? name 'cdr) (cdr (car arguments)))
        ((eq? name 'cons) (cons (car arguments) (second arguments)))
        ((eq? name 'list) arguments)
        ((eq? name 'eq?) (eq? (car arguments) (second arguments)))
        ((eq? name 'null?) (null? (car arguments)))
        ((eq? name 'pair?) (pair? (car arguments)))
        ((eq? name 'symbol?) (symbol? (car arguments)))
        ((eq? name '+) (+ (car arguments) (second arguments)))
        ((eq? name '-) (- (car arguments) (second arguments)))
        ((eq? name '=) (= (car arguments) (second arguments)))
        ((eq? name '<) (< (car arguments) (second arguments)))
        ((eq? name 'quotient) (quotient (car arguments) (second arguments)))
        ((eq? name 'remainder) (remainder (car arguments) (second arguments)))))

(define (second items) (car (cdr items)))

(define (third items) (car (cdr (cdr items))))

(define (fourth items) (car (cdr (cdr (cdr items)))))
