# Keep the existing PostgreSQL major and data directory; add the derived search
# extension without replacing or resetting the mounted database volume.
FROM postgres:18-alpine
ARG PGVECTOR_VERSION=0.8.7
RUN apk add --no-cache --virtual .vector-build build-base git \
    && git clone --depth 1 --branch "v${PGVECTOR_VERSION}" https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && make -C /tmp/pgvector with_llvm=no OPTFLAGS="" \
    && make -C /tmp/pgvector with_llvm=no install \
    && rm -rf /tmp/pgvector \
    && apk del .vector-build
