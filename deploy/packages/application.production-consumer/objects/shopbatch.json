{
  "name": "shopbatch",
  "type": "build.shopbatch",
  "title": "Production batch",
  "plural": "Production batchs",
  "fields": [
    {
      "name": "order",
      "title": "Order",
      "type": "reference",
      "ref": "build.shoporder",
      "required": true
    },
    {
      "name": "batch",
      "title": "Batch identity",
      "type": "text",
      "required": true
    },
    {
      "name": "yield",
      "title": "Good units",
      "type": "decimal"
    },
    {
      "name": "scrap",
      "title": "Scrapped units",
      "type": "decimal"
    },
    {
      "name": "final",
      "title": "Final batch",
      "type": "boolean"
    }
  ],
  "access": [
    {
      "role": "user",
      "read": "all",
      "create": true,
      "edit": false,
      "archive": false
    }
  ],
  "constraints": [
    {
      "name": "batchidentity",
      "kind": "unique",
      "fields": [
        "order",
        "batch"
      ],
      "message": "Batch identity has already been accepted.",
      "translations": {
        "zh-CN": "该批次标识已被接受。"
      }
    }
  ]
}
