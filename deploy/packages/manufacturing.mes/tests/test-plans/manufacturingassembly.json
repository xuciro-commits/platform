      "payload": "{\"code\":\"PORTABLE\",\"name\":\"Assembly procedure\",\"version\":1,\"from\":\"2026-01-01\"}",
      "expect": "accepted"
    },
    {
      "type": "build.mesoperation",
      "id": "assemblyoperation",
      "action": "build.mesoperation.create",
      "payload": "{\"routing\":\"assemblyroute\",\"number\":10,\"name\":\"Assembly\",\"center\":\"assemblycenter\"}",
      "expect": "accepted"
    },
    {
      "type": "build.mesrouting",
      "id": "assemblyroute",
      "action": "build.mesrouting.edit",
      "payload": "{\"first\":\"assemblyoperation\"}",
      "expect": "accepted"
    },
    {
      "type": "build.mesrouting",
      "id": "assemblyroute",
      "action": "build.mesrouting.release",
      "payload": "{}",
      "expect": "accepted"
    },
    {
      "type": "build.mesorder",
