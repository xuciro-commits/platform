      "expect": "accepted"
    },
    {
      "type": "build.mesbatch",
      "id": "assemblybatch",
      "action": "build.mesbatch.create",
      "payload": "{\"name\":\"assemblybatch\",\"order\":\"assemblyorder\",\"routing\":\"assemblyroute\",\"operation\":\"assemblyoperation\",\"quantity\":2}",
      "expect": "accepted"
    },
    {
      "type": "build.mesorder",
      "id": "assemblyorder",
      "action": "build.mesorder.release",
      "payload": "{}",
      "expect": "refused"
    },
    {
      "type": "build.mesbatch",
      "id": "assemblyremaining",
      "action": "build.mesbatch.create",
      "payload": "{\"name\":\"assemblyremaining\",\"order\":\"assemblyorder\",\"routing\":\"assemblyroute\",\"operation\":\"assemblyoperation\",\"quantity\":1}",
      "expect": "accepted"
    },
    {
      "type": "build.mesorder",
      "id": "assemblyorder",
      "action": "build.mesorder.release",
      "payload": "{}",
      "expect": "accepted"
    },
    {
      "type": "build.mesoperation",
      "id": "assemblyoperation",
      "action": "build.mesoperation.edit",
      "payload": "{\"name\":\"Changed after release\"}",
      "expect": "refused"
    },
    {
      "type": "build.mesbatch",
      "id": "assemblylate",
      "action": "build.mesbatch.create",
      "payload": "{\"name\":\"assemblylate\",\"order\":\"assemblyorder\",\"routing\":\"assemblyroute\",\"operation\":\"assemblyoperation\",\"quantity\":1}",
      "expect": "refused"
    },
    {
      "type": "build.mesbatch",
      "id": "assemblybatch",
      "action": "build.mesbatch.start",
