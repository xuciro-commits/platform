      "kind": "expression",
      "fields": [
        "start",
        "end",
        "unit"
      ],
      "level": "txn",
      "expr": {
        "op": "or",
        "kind": "boolean",
        "args": [
          {
            "op": "and",
            "kind": "boolean",
            "args": [
              {
                "op": "=",
                "kind": "boolean",
                "args": [
                  {
                    "op": "",
                    "kind": "choice",
                    "ref": "unit"
                  },
                  {
                    "op": "",
                    "kind": "choice",
                    "lit": {
                      "value": "day"
                    }
                  }
                ]
              },
              {
                "op": "=",
                "kind": "boolean",
                "args": [
                  {
                    "op": "",
                    "kind": "datetime",
                    "ref": "start"
                  },
                  {
                    "op": "start-of-day",
                    "kind": "datetime",
                    "args": [
                      {
                        "op": "",
                        "kind": "datetime",
                        "ref": "start"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "=",
                "kind": "boolean",
                "args": [
                  {
                    "op": "",
                    "kind": "datetime",
                    "ref": "end"
                  },
                  {
                    "op": "add-days",
                    "kind": "datetime",
                    "args": [
                      {
                        "op": "",
                        "kind": "datetime",
                        "ref": "start"
                      },
                      {
                        "op": "",
                        "kind": "integer",
                        "lit": {
                          "value": 1
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "and",
            "kind": "boolean",
            "args": [
              {
                "op": "=",
                "kind": "boolean",
                "args": [
                  {
                    "op": "",
                    "kind": "choice",
                    "ref": "unit"
                  },
                  {
                    "op": "",
                    "kind": "choice",
                    "lit": {
                      "value": "hour"
                    }
                  }
                ]
              },
              {
                "op": "=",
                "kind": "boolean",
                "args": [
                  {
                    "op": "",
                    "kind": "datetime",
                    "ref": "start"
                  },
                  {
                    "op": "start-of-hour",
                    "kind": "datetime",
                    "args": [
                      {
                        "op": "",
                        "kind": "datetime",
                        "ref": "start"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "=",
                "kind": "boolean",
                "args": [
                  {
                    "op": "",
                    "kind": "datetime",
                    "ref": "end"
                  },
                  {
                    "op": "add-hours",
                    "kind": "datetime",
                    "args": [
                      {
                        "op": "",
                        "kind": "datetime",
                        "ref": "start"
                      },
                      {
                        "op": "",
                        "kind": "integer",
                        "lit": {
                          "value": 1
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "message": "Capacity slots must follow their declared day or hour boundaries."
    },
    {
      "name": "validoccupancies",
      "kind": "expression",
      "fields": [
        "used"
      ],
      "level": "txn",
      "expr": {
        "op": "all",
        "kind": "boolean",
        "agg": {
          "source": "occupancies"
        },
        "in": {
          "op": "and",
          "kind": "boolean",
          "args": [
            {
              "op": "or",
              "kind": "boolean",
              "args": [
                {
                  "op": "=",
                  "kind": "boolean",
                  "args": [
                    {
                      "op": "path",
                      "kind": "choice",
                      "args": [
                        {
                          "op": "",
                          "kind": "reference",
                          "ref": "item.reservation"
                        }
                      ],
                      "path": [
                        "state"
                      ]
                    },
                    {
                      "op": "",
                      "kind": "choice",
                      "lit": {
                        "value": "held"
                      }
                    }
                  ]
                },
                {
                  "op": "=",
                  "kind": "boolean",
                  "args": [
                    {
                      "op": "path",
                      "kind": "choice",
                      "args": [
                        {
                          "op": "",
                          "kind": "reference",
                          "ref": "item.reservation"
                        }
                      ],
                      "path": [
                        "state"
                      ]
                    },
                    {
                      "op": "",
                      "kind": "choice",
                      "lit": {
                        "value": "booked"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "op": "=",
              "kind": "boolean",
              "args": [
                {
                  "op": "path",
                  "kind": "reference",
                  "args": [
                    {
                      "op": "",
                      "kind": "reference",
                      "ref": "item.reservation"
                    }
                  ],
                  "path": [
                    "roomtype"
                  ]
                },
                {
                  "op": "",
                  "kind": "reference",
                  "ref": "roomtype"
                }
              ]
            },
            {
              "op": "=",
              "kind": "boolean",
              "args": [
                {
                  "op": "path",
                  "kind": "choice",
                  "args": [
                    {
                      "op": "",
                      "kind": "reference",
                      "ref": "item.reservation"
                    }
                  ],
                  "path": [
                    "unit"
                  ]
                },
                {
                  "op": "",
                  "kind": "choice",
                  "ref": "unit"
                }
              ]
            },
            {
              "op": ">=",
              "kind": "boolean",
              "args": [
                {
                  "op": "",
                  "kind": "datetime",
                  "ref": "start"
                },
                {
                  "op": "path",
                  "kind": "datetime",
                  "args": [
                    {
                      "op": "",
                      "kind": "reference",
                      "ref": "item.reservation"
                    }
                  ],
                  "path": [
                    "begins"
                  ]
                }
              ]
            },
            {
              "op": "<=",
              "kind": "boolean",
              "args": [
                {
                  "op": "",
                  "kind": "datetime",
                  "ref": "end"
                },
                {
                  "op": "path",
                  "kind": "datetime",
                  "args": [
                    {
                      "op": "",
                      "kind": "reference",
                      "ref": "item.reservation"
                    }
                  ],
                  "path": [
                    "ends"
                  ]
                }
              ]
            }
          ]
        }
      },
      "message": "Occupied slots must agree with their active reservation.",
      "reads": {
        "collections": {
          "occupancies": {
            "app": "build",
            "object": "build.pmsoccupancy",
            "set": "occupancies",
            "policy": "complete"
          }
        }
      }
    },
    {
      "name": "oneslot",
      "kind": "unique",
      "fields": [
        "roomtype",
        "unit",
        "start"
      ],
      "message": "A room type has one capacity row for this time slot."
    }
  ],
  "type": "build.pmsslot"
}
