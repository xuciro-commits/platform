      "edit": false,
      "archive": false
    },
    {
      "role": "salesmanager",
      "read": "all",
      "create": false,
      "edit": false,
      "archive": false
    },
    {
      "role": "integrator",
      "read": "all",
      "create": true,
      "edit": true,
      "archive": false
    }
  ],
  "states": [
    {
      "name": "draft",
      "title": "Draft"
    },
    {
      "name": "active",
      "title": "Active"
    }
  ],
  "createTransaction": {
    "subject": "build.crmlodgingoffer",
