            ]
          }
        },
        "next": "done",
        "error": "review"
      },
      {
        "name": "failed",
        "kind": "action",
        "act": "fail",
        "next": "review",
        "error": "review"
      },
      {
        "name": "review",
        "kind": "ask",
        "ask": "hotelmanager",
        "title": "Review the rejected channel change and send a new correction when needed",
        "answers": [
          "reviewed"
        ],
        "cases": {
          "reviewed": "done"
        }
      },
      {
        "name": "done",
        "kind": "end"
      }
    ]
  }
}
