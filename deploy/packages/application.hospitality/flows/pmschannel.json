  "definition": {
    "name": "pmschannel",
    "title": "Apply a frozen channel message",
    "object": "build.pmschannelmessage",
    "when": "pending",
    "steps": [
      {
        "name": "kind",
        "kind": "switch",
        "value": {
          "source": "subject",
          "path": [
            "kind"
          ]
        },
        "cases": {
          "reserve": "reserveunit",
          "hold": "holdunit",
          "change": "changeunit",
          "confirm": "confirm",
          "cancel": "cancel",
          "release": "release"
        },
        "next": "failed"
      },
      {
        "name": "reserveunit",
        "kind": "switch",
        "value": {
          "source": "subject",
          "path": [
            "unit"
          ]
        },
        "cases": {
          "day": "reserveday",
          "hour": "reservehour"
        },
        "next": "failed"
      },
      {
        "name": "reserveday",
        "kind": "action",
        "act": "build.pmsreservation.create",
        "target": {
          "source": "subject",
          "path": [
            "reservation"
          ]
        },
        "inputs": {
          "roomtype": {
            "source": "subject",
            "path": [
              "roomtype"
            ]
          },
          "unit": {
            "source": "subject",
            "path": [
              "unit"
            ]
          },
          "dayfrom": {
            "source": "subject",
            "path": [
              "dayfrom"
            ]
          },
          "dayuntil": {
            "source": "subject",
            "path": [
              "dayuntil"
            ]
          },
          "guest": {
            "source": "subject",
            "path": [
              "guest"
            ]
          },
          "mode": {
            "source": "literal",
            "value": "booked"
          }
        },
        "next": "complete",
        "error": "failed",
        "retryAttempts": 1
      },
      {
        "name": "reservehour",
        "kind": "action",
        "act": "build.pmsreservation.create",
