  ],
  "actions": [
    {
      "description": "Create or link the organization, create the contact and the deal from this lead, and mark the lead converted.",
      "from": [
        "open"
      ],
      "inputs": [
        {
          "help": "Leave empty to create a new organization from the lead.",
          "name": "organization",
          "ref": "crm.organization",
          "title": "Link to organization",
          "type": "reference"
        }
      ],
      "name": "convert",
      "open": "deal",
      "title": "Convert to deal",
      "transaction": {
        "guard": {
          "args": [
            {
              "args": [
                {
                  "args": [
                    {
                      "kind": "boolean",
                      "op": "",
                      "ref": "converted"
                    },
                    {
                      "kind": "boolean",
                      "lit": {
                        "value": false
                      },
                      "op": ""
                    }
                  ],
                  "kind": "boolean",
                  "op": "coalesce"
                },
                {
                  "kind": "boolean",
                  "lit": {
                    "value": true
                  },
                  "op": ""
                }
              ],
              "kind": "boolean",
              "op": "!="
            },
            {
              "args": [
                {
                  "kind": "choice",
                  "op": "",
                  "ref": "status"
                },
                {
                  "kind": "choice",
                  "lit": {
                    "value": "unqualified"
                  },
                  "op": ""
                }
              ],
              "kind": "boolean",
              "op": "!="
            },
            {
              "args": [
                {
                  "kind": "choice",
                  "op": "",
                  "ref": "status"
                },
                {
                  "kind": "choice",
                  "lit": {
                    "value": "junk"
                  },
                  "op": ""
                }
              ],
              "kind": "boolean",
              "op": "!="
            }
          ],
          "kind": "boolean",
          "op": "and"
        },
        "message": "Only an open lead that is not yet converted, unqualified or junk can become a deal.",
        "steps": [
          {
            "changes": [
              {
                "expr": {
                  "args": [
                    {
                      "kind": "text",
                      "op": "",
                      "ref": "organizationname"
                    },
                    {
                      "kind": "text",
                      "op": "",
                      "ref": "fullname"
                    }
                  ],
                  "kind": "text",
                  "op": "coalesce"
                },
                "field": "name"
              },
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "website"
                },
                "field": "website"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "industry"
                },
                "field": "industry"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "territory"
                },
                "field": "territory"
              },
              {
                "expr": {
                  "kind": "choice",
                  "op": "",
                  "ref": "employees"
                },
                "field": "employees"
              }
            ],
            "kind": "create",
            "name": "organization",
            "target": {
              "type": "crm.organization"
            },
            "when": {
              "args": [
                {
                  "kind": "reference",
                  "op": "",
                  "ref": "input.organization"
                }
              ],
              "kind": "boolean",
              "op": "empty"
            }
          },
          {
            "changes": [
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "fullname"
                },
                "field": "fullname"
              },
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "email"
                },
                "field": "email"
              },
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "mobile"
                },
                "field": "mobile"
              },
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "phone"
                },
                "field": "phone"
              },
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "jobtitle"
                },
                "field": "designation"
              },
              {
                "expr": {
                  "args": [
                    {
                      "kind": "reference",
                      "op": "",
                      "ref": "input.organization"
                    },
                    {
                      "kind": "reference",
                      "op": "",
                      "ref": "step.organization"
                    }
                  ],
                  "kind": "reference",
                  "op": "coalesce"
                },
                "field": "organization"
              }
            ],
            "kind": "create",
            "name": "contact",
            "target": {
              "type": "crm.crmcontact"
            }
          },
          {
            "changes": [
              {
                "expr": {
                  "args": [
                    {
                      "kind": "text",
                      "op": "",
                      "ref": "organizationname"
                    },
                    {
                      "kind": "text",
                      "op": "",
                      "ref": "fullname"
                    }
                  ],
                  "kind": "text",
                  "op": "coalesce"
                },
                "field": "title"
              },
              {
                "expr": {
                  "args": [
                    {
                      "kind": "reference",
                      "op": "",
                      "ref": "input.organization"
                    },
                    {
                      "kind": "reference",
                      "op": "",
                      "ref": "step.organization"
                    }
                  ],
                  "kind": "reference",
                  "op": "coalesce"
                },
                "field": "organization"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "step.contact"
                },
                "field": "contact"
              },
              {
                "field": "lead",
                "from": "$subject"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "source"
                },
                "field": "source"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "industry"
                },
                "field": "industry"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "territory"
                },
                "field": "territory"
              },
              {
                "expr": {
                  "kind": "choice",
                  "lit": {
                    "value": "qualification"
                  },
                  "op": ""
                },
                "field": "status"
              },
              {
                "expr": {
                  "kind": "integer",
                  "lit": {
                    "value": 10
                  },
                  "op": ""
                },
                "field": "probability"
              },
              {
                "expr": {
                  "kind": "text",
                  "op": "",
                  "ref": "owner"
                },
                "field": "owner"
              }
            ],
            "kind": "create",
            "name": "deal",
            "target": {
              "type": "crm.deal"
            }
          },
          {
            "changes": [
              {
                "expr": {
                  "kind": "boolean",
                  "lit": {
                    "value": true
                  },
                  "op": ""
                },
                "field": "converted"
              },
              {
                "expr": {
                  "kind": "choice",
                  "lit": {
                    "value": "qualified"
                  },
                  "op": ""
                },
                "field": "status"
              },
              {
                "expr": {
                  "kind": "reference",
                  "op": "",
                  "ref": "step.deal"
                },
                "field": "deal"
              }
            ],
            "kind": "update",
            "name": "lead",
            "target": {
              "id": "$subject",
              "type": "crm.lead"
            }
          }
        ],
        "subject": "crm.lead"
      }
    }
