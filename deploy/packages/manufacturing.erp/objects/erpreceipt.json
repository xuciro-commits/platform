    "message": "A stock receipt belongs to exactly one ordered purchase or running production batch."
  },
  "constraints": [
    {
      "name": "frozenreceipt",
      "kind": "immutable",
      "fields": [
        "purchase",
        "date",
        "production",
        "batch"
      ],
      "message": "A stock receipt retains its accepted original order and date."
    }
  ],
  "type": "build.erpreceipt"
}
