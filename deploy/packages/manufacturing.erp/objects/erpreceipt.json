{
  "name": "erpreceipt",
  "title": "Stock receipt",
  "fields": [
    {
      "name": "purchase",
      "title": "Purchase order",
      "type": "reference",
      "ref": "build.erppurchase",
      "inverse": "receipts"
    },
    {
      "name": "date",
      "title": "Receipt date",
      "type": "date",
      "required": true
    },
    {
      "name": "production",
      "title": "Production order",
      "type": "reference",
      "ref": "build.productionorder",
      "inverse": "receipts"
    },
    {
      "name": "batch",
      "title": "Production batch identity",
      "type": "text"
    }
  ],
  "access": [
    {
      "role": "buyer",
      "read": "all",
      "create": true,
      "edit": false,
      "archive": false
    },
    {
      "role": "accountant",
      "read": "all",
      "create": true,
      "edit": false,
      "archive": false
    },
    {
      "role": "controller",
      "read": "all",
      "create": true,
      "edit": false,
      "archive": false
    },
    {
      "role": "production",
      "read": "all",
      "create": true,
      "edit": false,
      "archive": false
    }
  ],
  "sets": [
    {
      "name": "moves",
      "from": "moves",
      "direction": "inverse",
      "object": "build.erpmove",
      "order": [
        {
          "expr": {
            "op": "",
            "kind": "text",
            "ref": "id"
          }
        }
      ],
      "limit": 10000
    }
  ],
  "states": [
    {
      "name": "draft",
      "title": "Draft"
    },
    {
      "name": "recorded",
      "title": "Recorded"
    }
  ],
  "createTransaction": {
    "subject": "build.erpreceipt",
    "steps": [
      {
        "name": "recorded",
        "kind": "update",
        "target": {
          "type": "build.erpreceipt",
          "id": "$subject"
        },
        "changes": [
          {
            "field": "state",
            "expr": {
              "op": "",
              "kind": "choice",
              "lit": {
                "value": "recorded"
              }
            }
          }
        ]
      }
    ],
    "guard": {
      "op": "or",
      "kind": "boolean",
      "args": [
        {
          "op": "and",
          "kind": "boolean",
          "args": [
            {
              "op": "empty",
              "kind": "boolean",
              "args": [
                {
                  "op": "coalesce",
