                    "value": "ordered"
                  }
                }
              ]
            }
          ]
        },
        {
          "op": "and",
          "kind": "boolean",
          "args": [
            {
              "op": "empty",
              "kind": "boolean",
              "args": [
                {
                  "op": "coalesce",
                  "kind": "reference",
                  "args": [
                    {
                      "op": "",
                      "kind": "reference",
                      "ref": "purchase"
                    },
                    {
                      "op": "",
                      "kind": "reference",
                      "lit": {
                        "value": ""
                      }
                    }
                  ]
                }
              ]
            },
            {
              "op": "not",
              "kind": "boolean",
              "args": [
                {
                  "op": "empty",
                  "kind": "boolean",
                  "args": [
                    {
                      "op": "coalesce",
                      "kind": "reference",
                      "args": [
                        {
                          "op": "",
                          "kind": "reference",
                          "ref": "production"
                        },
                        {
                          "op": "",
                          "kind": "reference",
                          "lit": {
                            "value": ""
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "not",
              "kind": "boolean",
              "args": [
                {
                  "op": "empty",
                  "kind": "boolean",
                  "args": [
                    {
                      "op": "coalesce",
                      "kind": "text",
                      "args": [
                        {
                          "op": "",
                          "kind": "text",
                          "ref": "batch"
                        },
                        {
                          "op": "",
                          "kind": "text",
                          "lit": {
                            "value": ""
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "=",
              "kind": "boolean",
              "args": [
                {
                  "op": "path",
                  "kind": "choice",
                  "args": [
                    {
                      "op": "",
                      "kind": "reference",
                      "ref": "production"
                    }
                  ],
                  "path": [
                    "state"
                  ]
                },
                {
                  "op": "",
                  "kind": "choice",
                  "lit": {
                    "value": "running"
