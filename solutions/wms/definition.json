      "fields": [
        {
          "name": "receipt",
          "title": "Receipt / 收货单",
          "type": "reference",
          "ref": "build.wmsreceipt",
          "inverse": "lines",
          "required": true
        },
        {
          "name": "item",
          "title": "Item / 物料",
          "type": "reference",
          "ref": "build.wmsitem",
          "inverse": "receiptlines",
          "required": true
        },
        {
          "name": "expected",
          "title": "Expected quantity / 预计数量",
          "type": "integer",
          "required": true
        },
        {
          "name": "lot",
          "title": "Lot / 批次",
          "type": "text"
        },
        {
          "name": "note",
          "title": "Note / 备注",
          "type": "longtext"
        }
      ],
      "access": [
        {
          "role": "user",
          "read": "all",
          "create": true,
          "edit": true,
          "archive": true
        },
        {
          "role": "supervisor",
          "read": "all"
        }
      ]
    },
    {
      "id": "WMS-TASK",
      "name": "wmstask",
      "title": "Receiving operation / 收货作业",
      "plural": "Receiving operation / 收货作业",
      "fields": [
        {
          "name": "name",
          "title": "Operation number / 作业编号",
          "type": "text",
          "required": true,
          "search": true
        },
        {
          "name": "line",
          "title": "Receipt line / 收货明细",
          "type": "reference",
          "ref": "build.wmsreceiptline",
          "inverse": "tasks",
          "required": true
        },
        {
          "name": "location",
          "title": "Destination / 目标库位",
          "type": "reference",
          "ref": "build.wmslocation",
          "inverse": "tasks",
          "required": true
        },
        {
          "name": "quantity",
          "title": "Received quantity / 实收数量",
          "type": "integer",
          "required": true
        },
        {
          "name": "unitsperpallet",
          "title": "Units per pallet / 每托盘数量",
          "type": "integer",
          "required": true
        },
        {
          "name": "pallets",
          "title": "Pallets / 托盘数",
          "type": "integer",
          "write": [
            "builder"
          ]
        },
        {
          "name": "completedby",
          "title": "Completed by / 执行人",
          "type": "text",
          "write": [
            "builder"
          ]
        },
        {
          "name": "completedat",
          "title": "Completed at / 完成时间",
          "type": "datetime",
          "write": [
            "builder"
          ]
        }
      ],
      "access": [
        {
          "role": "user",
          "read": "all",
          "create": true,
          "edit": false,
          "archive": false
        },
        {
          "role": "supervisor",
          "read": "all"
        }
      ],
      "states": [
        {
          "name": "open",
          "title": "Open / 待执行",
          "tone": "info"
        },
        {
          "name": "ready",
          "title": "Calculating / 计算中",
          "tone": "warning"
        },
        {
          "name": "calculated",
          "title": "Calculated / 已计算",
          "tone": "info"
        },
        {
          "name": "pending",
          "title": "Awaiting approval / 待审批",
          "tone": "warning"
        },
        {
          "name": "done",
          "title": "Put away / 已上架",
          "tone": "success"
        },
        {
          "name": "rejected",
          "title": "Rejected / 已驳回",
          "tone": "danger"
        },
        {
          "name": "cancelled",
          "title": "Cancelled / 已取消",
          "tone": "neutral"
        }
      ],
      "actions": [
        {
          "name": "start",
          "title": "Submit receiving / 提交收货",
          "from": [
            "open"
          ],
          "to": "ready",
          "conditions": [
            {
              "field": "quantity",
              "operator": ">",
              "value": "0",
              "message": "Quantity must be positive / 数量必须大于零"
            },
            {
              "field": "unitsperpallet",
              "operator": ">",
              "value": "0",
              "message": "Quantity must be positive / 数量必须大于零"
            },
            {
              "field": "line.receipt.state",
              "operator": "=",
              "value": "receiving",
              "message": "The receipt must be receiving / 父收货单必须处于收货中"
            },
            {
              "field": "quantity",
              "operator": "<=",
              "valueField": "line.expected",
              "message": "Quantity exceeds the receipt line expectation / 本次收货数量超过明细预计量"
            }
          ],
          "roles": [
            "user"
          ]
        },
        {
          "name": "plan",
          "title": "Apply pallet plan / 应用托盘计算",
          "from": [
            "ready"
          ],
          "to": "calculated",
          "inputs": [
            {
              "name": "pallets",
              "title": "Pallets / 托盘数",
              "type": "integer",
              "required": true
            }
          ],
          "sets": [
            {
              "field": "pallets",
              "from": "pallets"
            }
          ],
          "conditions": [
            {
              "field": "input.pallets",
              "operator": ">",
              "value": "0",
              "message": "Quantity must be positive / 数量必须大于零"
            }
          ],
          "roles": [
            "user"
          ]
        },
        {
          "name": "confirm",
          "title": "Confirm putaway / 确认上架",
          "from": [
            "calculated"
          ],
          "to": "done",
          "sets": [
            {
              "field": "completedby",
              "from": "$me"
            },
            {
              "field": "completedat",
              "from": "$now"
            }
          ],
          "approval": {
            "pending": "pending",
            "rejected": "rejected",
            "levels": [
              {
                "title": "Warehouse supervisor / 仓库主管",
                "role": "supervisor"
              }
            ]
          },
          "conditions": [
            {
              "field": "line.receipt.state",
              "operator": "=",
              "value": "receiving",
              "message": "The receipt must be receiving / 父收货单必须处于收货中"
            },
            {
              "field": "quantity",
              "operator": "<=",
              "valueField": "line.expected",
              "message": "Quantity exceeds the receipt line expectation / 本次收货数量超过明细预计量"
            }
          ],
          "roles": [
            "user"
          ]
        },
        {
          "name": "cancel",
          "title": "Cancel operation / 取消作业",
          "from": [
            "open"
          ],
          "to": "cancelled",
          "roles": [
            "user"
          ]
        }
      ]
    }
  ],
  "code": {
    "id": "WMS-PALLETS",
    "name": "wmspallets",
    "title": "Pallet planning / 托盘计算",
    "description": "Pure quantity calculation; no database or external calls / 纯数量计算，无数据库或外部调用",
    "language": "go",
    "roles": [
      "builder",
      "user"
    ],
    "input": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": "integer"
        },
        "unitsPerPallet": {
          "type": "integer"
        }
      },
      "required": [
        "quantity",
        "unitsPerPallet"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "pallets": {
          "type": "integer"
        }
      },
      "required": [
        "pallets"
      ]
    },
    "limits": {
      "timeoutMillis": 1000,
      "memoryPages": 1024,
      "maxInputBytes": 4096,
      "maxOutputBytes": 4096
    }
  },
  "process": {
    "id": "WMS-RECEIVE",
    "name": "wmsreceive",
    "title": "Receive, calculate and approve / 收货计算与审批",
    "object": "build.wmstask",
    "when": "ready",
    "steps": [
      {
        "name": "calculate",
        "title": "Calculate pallets / 计算托盘",
        "kind": "compute",
        "operation": {
          "app": "build",
          "name": "wmspallets",
          "version": 1
        },
        "inputs": {
          "quantity": {
            "source": "subject",
            "path": [
              "quantity"
            ]
          },
          "unitsPerPallet": {
            "source": "subject",
            "path": [
              "unitsperpallet"
            ]
          }
        },
        "next": "plan"
      },
      {
        "name": "plan",
        "title": "Apply plan / 写入计算",
        "kind": "action",
        "act": "plan",
        "inputs": {
          "pallets": {
            "source": "step",
            "step": "calculate",
            "path": [
              "pallets"
            ]
          }
        },
        "next": "approve"
      },
      {
        "name": "approve",
        "title": "Approve putaway / 审批上架",
        "kind": "action",
        "act": "confirm",
        "next": "end"
      },
      {
        "name": "end",
        "title": "Completed / 完成",
        "kind": "end"
      }
    ],
    "layout": {
      "calculate": {
        "x": 0,
        "y": 0
      },
      "plan": {
        "x": 300,
        "y": 0
      },
      "approve": {
        "x": 600,
        "y": 0
      },
      "end": {
        "x": 900,
        "y": 0
      }
    }
  },
