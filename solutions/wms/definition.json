        }
      ],
      "states": [
        {
          "name": "open",
          "title": "Open / 新建",
          "tone": "info"
        },
        {
          "name": "receiving",
          "title": "Receiving / 收货中",
          "tone": "warning"
        },
        {
          "name": "done",
          "title": "Closed / 已关闭",
          "tone": "success"
        },
        {
          "name": "cancelled",
          "title": "Cancelled / 已取消",
          "tone": "neutral"
        }
      ],
      "actions": [
        {
          "name": "start",
          "title": "Start receiving / 开始收货",
          "from": [
            "open"
          ],
          "to": "receiving",
          "roles": [
            "user"
          ]
        },
        {
          "name": "close",
          "title": "Close receipt / 关闭收货单",
          "from": [
            "receiving"
          ],
          "to": "done",
          "roles": [
            "user"
          ]
        },
        {
          "name": "cancel",
          "title": "Cancel / 取消",
          "from": [
            "open",
            "receiving"
          ],
          "to": "cancelled",
          "roles": [
            "user"
          ]
        }
      ]
    },
    {
      "id": "WMS-RECEIPTLINE",
