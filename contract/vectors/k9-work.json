    {
      "id": "k9.stale-generation",
      "rules": [
        "W1",
        "W2",
        "W4"
      ],
      "given": {},
      "steps": [
        {
          "start": {
            "workId": "search",
            "ownerId": "win-1"
          },
          "expect": {
            "generation": 1
          }
        },
        {
          "checkpoint": {
            "workId": "search",
            "generation": 1,
            "progress": 5,
            "checkpoint": "q=ab"
          },
          "expect": {
            "ok": true
          }
        },
        {
          "cancel": {
            "workId": "search"
          },
          "expect": {
            "ok": true
          }
        },
        {
          "cancel": {
            "workId": "search"
          },
          "expect": {
            "error": "ERROR_CODE_CONFLICT"
          }
        },
        {
          "start": {
            "workId": "search",
            "ownerId": "win-1"
          },
          "expect": {
            "generation": 2,
            "resumeFrom": "q=ab"
          }
        },
        {
          "complete": {
            "workId": "search",
            "generation": 1
          },
          "expect": {
            "error": "ERROR_CODE_CONFLICT"
          }
        },
        {
          "checkpoint": {
            "workId": "search",
            "generation": 1,
            "progress": 9
          },
          "expect": {
            "error": "ERROR_CODE_CONFLICT"
          }
        },
        {
          "checkpoint": {
            "workId": "search",
            "generation": 2,
            "progress": 1
          },
          "expect": {
            "ok": true
          }
        },
        {
          "state": {
            "workId": "search"
          },
          "expect": {
            "work": {
              "workId": "search",
              "ownerId": "win-1",
              "generation": 2,
              "state": "WORK_STATE_RUNNING",
              "progress": 1,
              "checkpoint": "q=ab"
            }
          }
        },
        {
          "fail": {
            "workId": "search",
            "generation": 2
          },
          "expect": {
            "ok": true
          }
        },
        {
          "state": {
            "workId": "search"
          },
          "expect": {
            "work": {
              "workId": "search",
              "ownerId": "win-1",
              "generation": 2,
              "state": "WORK_STATE_FAILED",
              "progress": 1,
              "checkpoint": "q=ab"
            }
          }
        }
      ]
    },
